set prefix soc/u_e203_subsys_main/u_e203_subsys_perips/accelerator/controller/core
foreach {leaf old new} {
    U3460 OA21V2_12TR40 OA21V8_12TR40
    U6593 CLKINV0_12TR40 CLKINV12_12TR40
    U5340 CLKINV2_12TR40 CLKINV12_12TR40
    U5660 CLKINV2_12TR40 CLKINV12_12TR40
    U2196 CLKINV2_12TR40 CLKINV12_12TR40
    U5468 CLKINV2_12TR40 CLKINV12_12TR40
    U9150 OAI211V0_12TR40 OAI211V4_12TR40
    U17730 AOI222V1_12TR40 AOI222V2_12TR40
    U17744 AOI222V0_12TR40 AOI222V2_12TR40
    U220 CLKINV2_12TR40 CLKINV12_12TR40
    U5348 AOI2XB1V2_12TR40 AOI2XB1V8_12TR40
    U5347 CLKINV0_12TR40 CLKINV12_12TR40
    U75 CLKINV2_12TR40 CLKINV12_12TR40
    U20330 AOI21V0_12TR40 AOI21V8_12TR40
    U12705 AOI222V0_12TR40 AOI222V2_12TR40
} {
    set cell [get_cells $prefix/$leaf]
    if {[get_attribute $cell ref_name] ne $old} {error "Inspect actual failed-checkpoint driver $prefix/$leaf"}
    puts "XPIAN_LITERATURE_OBSERVED_RESIZE $prefix/$leaf $old -> $new"
    size_cell $cell [get_lib_cells */$new]
}
puts "XPIAN_LITERATURE_TIMING_REPAIR_DONE=1"
