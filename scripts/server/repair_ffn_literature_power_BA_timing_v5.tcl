set prefix soc/u_e203_subsys_main/u_e203_subsys_perips/accelerator/controller/core
foreach {leaf old new} {
    U128 NOR2CV2_12TR40 NOR2CV8_12TR40
    U744 INV0_12TR40 INV12_12TR40
    U10193 NAND2CV0_12TR40 NAND2CV4_12TR40
    U5522 NOR2CV4_12TR40 NOR2CV12_12TR40
    U5523 CLKINV0_12TR40 CLKINV12_12TR40
    U10574 CLKINV0_12TR40 CLKINV12_12TR40
    U3632 INV0_12TR40 INV12_12TR40
    U6330 NOR3CV3_12TR40 NOR3CV8_12TR40
    U6343 CLKINV2_12TR40 CLKINV12_12TR40
    U10045 NOR2CV1_12TR40 NOR2CV8_12TR40
    U10046 INV0_12TR40 INV12_12TR40
    U5428 CLKINV2_12TR40 CLKINV12_12TR40
    U5761 NOR2CV2_12TR40 NOR2CV8_12TR40
    U9732 CLKINV0_12TR40 CLKINV12_12TR40
    U9842 CLKINV0_12TR40 CLKINV12_12TR40
} {
    set cell [get_cells $prefix/$leaf]
    if {[get_attribute $cell ref_name] ne $old} {error "Inspect actual failed-checkpoint driver $prefix/$leaf"}
    puts "XPIAN_LITERATURE_OBSERVED_RESIZE $prefix/$leaf $old -> $new"
    size_cell $cell [get_lib_cells */$new]
}
puts "XPIAN_LITERATURE_TIMING_REPAIR_DONE=1"
