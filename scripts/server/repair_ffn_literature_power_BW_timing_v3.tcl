set prefix soc/u_e203_subsys_main/u_e203_subsys_perips/accelerator/controller/core
foreach {leaf old new} {
    U221 CLKINV2_12TR40 CLKINV8_12TR40
    U3764 CLKINV3_12TR40 CLKINV12_12TR40
    U5339 OAI21V2_12TR40 OAI21V8_12TR40
    U13631 AOI222V0_12TR40 AOI222V2_12TR40
    U5485 CLKINV0_12TR40 CLKINV8_12TR40
    U218 CLKINV2_12TR40 CLKINV12_12TR40
    U5350 CLKINV2_12TR40 CLKINV12_12TR40
    U17322 AOI222V0_12TR40 AOI222V2_12TR40
    U5877 OA21V2_12TR40 OA21V8_12TR40
    U6026 CLKINV2_12TR40 CLKINV8_12TR40
    U4092 CLKINV2_12TR40 CLKINV12_12TR40
    U5684 XNOR2V1_12TR40 XNOR2V8_12TR40
    U4785 CLKINV0_12TR40 CLKINV8_12TR40
    U98 CLKINV4_12TR40 CLKINV12_12TR40
    U5643 AOI2XB1V1_12TR40 AOI2XB1V8_12TR40
} {
    set cell [get_cells $prefix/$leaf]
    if {[get_attribute $cell ref_name] ne $old} {error "Inspect actual failed-checkpoint driver $prefix/$leaf"}
    puts "XPIAN_LITERATURE_OBSERVED_RESIZE $prefix/$leaf $old -> $new"
    size_cell $cell [get_lib_cells */$new]
}
puts "XPIAN_LITERATURE_TIMING_REPAIR_DONE=1"
