set prefix soc/u_e203_subsys_main/u_e203_subsys_perips/accelerator/controller/core
foreach {leaf old new} {
    U5850 OA21V2_12TR40 OA21V8_12TR40
    U5326 CLKINV2_12TR40 CLKINV12_12TR40
    U50 INV2SR_12TR40 INV12_12TR40
    U3190 NAND2V2_12TR40 NAND2V8_12TR40
    U5756 OA21V2_12TR40 OA21V8_12TR40
    U6328 INV0_12TR40 INV12_12TR40
    U62 NOR2CV4_12TR40 NOR2CV12_12TR40
    U5220 CLKINV2_12TR40 CLKINV12_12TR40
    U51 INV2SR_12TR40 INV12_12TR40
    U5638 CLKINV0_12TR40 CLKINV12_12TR40
    U5639 AOI2XB1V0_12TR40 AOI2XB1V4_12TR40
    U5640 CLKINV0_12TR40 CLKINV12_12TR40
    U2292 CLKINV6_12TR40 CLKINV12_12TR40
    U5907 CLKINV4_12TR40 CLKINV12_12TR40
    U452 AOI222V0_12TR40 AOI222V2_12TR40
    U6430 OA21V2_12TR40 OA21V8_12TR40
    U3365 CLKINV2_12TR40 CLKINV12_12TR40
} {
    set cell [get_cells $prefix/$leaf]
    if {[get_attribute $cell ref_name] ne $old} {error "Inspect actual failed-checkpoint driver $prefix/$leaf"}
    puts "XPIAN_LITERATURE_OBSERVED_RESIZE $prefix/$leaf $old -> $new"
    size_cell $cell [get_lib_cells */$new]
}
puts "XPIAN_LITERATURE_TIMING_REPAIR_DONE=1"
